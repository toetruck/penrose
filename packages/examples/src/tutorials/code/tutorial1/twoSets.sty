 /**************YOUR CODE - START********************/
canvas {
  width = (800)
  height = (700)
}
forall Set x {
    x.icon =  Circle {
        strokeWidth : 0.0
    }
}
forall Relationship xy {
    xy.icon =  Line {
        strokeWidth : 0.0
    }
}
forall Observer y {
    y.icon =  Polygon {
        strokeWidth : 0.0
    }
}
/**************YOUR CODE - END**********************/
